<Window x:Class="CitaPDF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CitaPDF"
        mc:Ignorable="d"
        Title="CitaPDF — Citas APA automáticas" Height="640" Width="1000"
        MinHeight="480" MinWidth="760"
        AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver"
        Closing="Window_Closing">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="180"/>
        </Grid.RowDefinitions>

        <!-- Barra de adquisición -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Grid.Column="0">
                <Button x:Name="BtnAgregarArchivos" Content="Agregar archivo(s)..." Padding="10,6"
                        Click="BtnAgregarArchivos_Click"/>
                <Button x:Name="BtnAgregarCarpeta" Content="Agregar carpeta..." Padding="10,6" Margin="8,0,0,0"
                        Click="BtnAgregarCarpeta_Click"/>
                <CheckBox x:Name="ChkSubcarpetas" Content="Incluir subcarpetas" VerticalAlignment="Center" Margin="8,0,0,0"/>
                <TextBox x:Name="TxtUrl" Width="280" Margin="16,0,0,0" VerticalContentAlignment="Center"
                         ToolTip="URL(s) de descarga directa de un PDF, separadas por ';' si son varias"/>
                <Button x:Name="BtnAgregarUrl" Content="Agregar por URL" Padding="10,6" Margin="8,0,0,0"
                        Click="BtnAgregarUrl_Click"/>
            </StackPanel>
            <Button x:Name="BtnConfiguracion" Grid.Column="1" Content="⚙ Configuración" Padding="10,6"
                    Click="BtnConfiguracion_Click"/>
        </Grid>

        <!-- Info / vaciar -->
        <Grid Grid.Row="1" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="TxtEstadoVacio" Grid.Column="0"
                       Text="Todavía no se catalogó ningún documento. Soltá uno o varios PDFs acá, o usá los botones de arriba."
                       Foreground="Gray" FontStyle="Italic" VerticalAlignment="Center"/>
            <Button x:Name="BtnVerBiblioteca" Grid.Column="1" Content="Ver biblioteca completa"
                    Padding="10,6" Click="BtnVerBiblioteca_Click"/>
        </Grid>

        <!-- Grid principal: historial reciente, funciona como biblioteca -->
        <DataGrid x:Name="GridDocumentos" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionMode="Single" SelectionUnit="FullRow"
                  MouseDoubleClick="GridDocumentos_MouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Título" Binding="{Binding Titulo}" Width="3*"/>
                <DataGridTextColumn Header="Autores" Binding="{Binding AutoresTexto}" Width="2*"/>
                <DataGridTextColumn Header="Año" Binding="{Binding Anio}" Width="70"/>
                <DataGridTextColumn Header="Editorial" Binding="{Binding Editorial}" Width="2*"/>
                <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="140"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Log -->
        <RichTextBox x:Name="TxtLog" Grid.Row="3" Margin="0,8,0,0"
                     Background="#FF1E1E1E" Foreground="White"
                     BorderThickness="0" IsReadOnly="True"
                     FontFamily="Consolas" FontSize="12"
                     VerticalScrollBarVisibility="Auto"/>
    </Grid>
</Window>
