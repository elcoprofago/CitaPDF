<?xml version="1.0" encoding="utf-8"?>
<!-- https://go.microsoft.com/fwlink/?LinkID=208121. -->
<!-- Versión portable: un único CitaPDF.exe autocontenido (incluye .NET, corre
     en cualquier Windows x64 sin instalar nada) + carpeta "datos" junto al
     .exe, que activa el modo portable (ver Biblioteca.GetDataDir).
     OJO: el diálogo de publicación de Visual Studio reescribe este archivo
     (ya lo dejó una vez en SelfContained=false). publicar.ps1 publica con
     estos valores explícitos, sin depender de este perfil. -->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <!-- Carpeta propia: publicar no borra lo que ya hay, y "publish\" y
         "publish-portable\" tienen publicaciones dependientes de .NET. -->
    <PublishDir>bin\Release\net8.0-windows\CitaPDF-portable\</PublishDir>
    <PublishProtocol>FileSystem</PublishProtocol>
    <_TargetId>Folder</_TargetId>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>
</Project>
