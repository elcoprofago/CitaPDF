<Window x:Class="CitaPDF.UnificarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Unificar bibliotecas" Width="920" Height="720" MinWidth="700" MinHeight="400"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" BorderBrush="#FFBBBBBB" BorderThickness="1" Padding="8" Background="#FFF6F6F6">
                <StackPanel>
                    <TextBlock Text="Esta biblioteca (en uso)" FontWeight="Bold"/>
                    <TextBlock x:Name="TxtInfoLocal" TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" BorderBrush="#FFBBBBBB" BorderThickness="1" Padding="8" Background="#FFF6F6F6">
                <StackPanel>
                    <TextBlock Text="La otra (no se modifica)" FontWeight="Bold"/>
                    <TextBlock x:Name="TxtInfoOtra" TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <TextBlock Grid.Row="1" x:Name="TxtResumen" TextWrapping="Wrap" Margin="0,10,0,6"/>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Expander x:Name="ExpConflictos" IsExpanded="True" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Foreground="Gray" FontStyle="Italic" TextWrapping="Wrap" Margin="0,4,0,6"
                                   Text="El mismo documento tiene datos distintos en cada biblioteca. Elegí qué versión conservar en cada caso (sólo se reemplazan los campos que se muestran; los demás ya se unificaron). La sugerida es la modificada más recientemente o, si no hay fecha, la que tiene más datos."/>
                        <ItemsControl x:Name="ListaConflictos">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#FFCCCCCC" BorderThickness="0,0,0,1" Padding="0,6">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Encabezado}" FontWeight="Bold" TextWrapping="Wrap"/>
                                            <!-- Los dos RadioButton comparten panel padre y por eso
                                                 forman grupo solos (sin GroupName, que sería común a
                                                 toda la ventana). -->
                                            <Grid Margin="0,4,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <RadioButton Grid.Column="0" IsChecked="{Binding ElegirLocal}" Margin="0,0,10,0" VerticalContentAlignment="Top">
                                                    <TextBlock Text="{Binding TextoLocal}" TextWrapping="Wrap"/>
                                                </RadioButton>
                                                <RadioButton Grid.Column="1" IsChecked="{Binding ElegirOtro}" VerticalContentAlignment="Top">
                                                    <TextBlock Text="{Binding TextoOtro}" TextWrapping="Wrap"/>
                                                </RadioButton>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Expander>

                <Expander x:Name="ExpAgregados" IsExpanded="True" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Foreground="Gray" FontStyle="Italic" TextWrapping="Wrap" Margin="0,4,0,6"
                                   Text="Están sólo en la otra biblioteca y se agregan a ésta. Desmarcá los que hayas borrado acá a propósito."/>
                        <ItemsControl x:Name="ListaAgregados">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding Incluir}" Margin="0,2">
                                        <TextBlock Text="{Binding Texto}" TextWrapping="Wrap"/>
                                    </CheckBox>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Expander>

                <Expander x:Name="ExpCompletados" IsExpanded="False">
                    <StackPanel>
                        <TextBlock Foreground="Gray" FontStyle="Italic" TextWrapping="Wrap" Margin="0,4,0,6"
                                   Text="Campos vacíos en esta biblioteca que se completan con los de la otra (no pisan nada)."/>
                        <ItemsControl x:Name="ListaCompletados">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,2"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>

        <DockPanel Grid.Row="3" Margin="0,10,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="BtnUnificar" Content="Unificar" Padding="14,6" Click="BtnUnificar_Click" IsDefault="True"/>
                <Button Content="Cancelar" Padding="10,6" Margin="8,0,0,0" IsCancel="True"/>
            </StackPanel>
            <TextBlock Foreground="Gray" FontStyle="Italic" TextWrapping="Wrap" VerticalAlignment="Center"
                       Text="Antes de guardar se hace una copia de respaldo de esta biblioteca en datos\respaldos. Nada se borra."/>
        </DockPanel>
    </Grid>
</Window>
