<Window x:Class="CitaPDF.UbicarPdfWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ubicar PDF" Width="620" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Closing="Window_Closing" PreviewKeyDown="Window_PreviewKeyDown">
    <StackPanel Margin="14">
        <TextBlock x:Name="TxtMensaje" TextWrapping="Wrap" Margin="0,0,0,8"/>
        <DockPanel Margin="0,0,0,10">
            <Button x:Name="BtnUsarRuta" DockPanel.Dock="Right" Content="Usar esta ruta" Padding="10,4"
                    Margin="8,0,0,0" VerticalAlignment="Top" Click="BtnUsarRuta_Click"/>
            <TextBox x:Name="TxtRuta" TextWrapping="Wrap" Padding="2,3" KeyDown="TxtRuta_KeyDown"/>
        </DockPanel>
        <TextBlock TextWrapping="Wrap" Foreground="Gray" Margin="0,0,0,10"
                   Text="Podés corregir la ruta a mano (por ejemplo, si cambió la letra de la unidad). El PDF también se reconoce por su contenido, no por el nombre: al buscar en una carpeta se encuentra aunque lo hayas renombrado, se revisan sus subcarpetas, y se aprovecha para encontrar los demás PDFs de la biblioteca que falten."/>
        <TextBlock x:Name="TxtProgreso" TextWrapping="Wrap" Margin="0,0,0,10" Visibility="Collapsed"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="BtnElegir" Content="Elegir el archivo..." Padding="10,6" Click="BtnElegir_Click"/>
            <Button x:Name="BtnBuscar" Content="Buscar en una carpeta..." Padding="10,6" Margin="8,0,0,0" Click="BtnBuscar_Click"/>
            <Button x:Name="BtnCancelar" Content="Cancelar" Padding="10,6" Margin="8,0,0,0" Click="BtnCancelar_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
