<Window x:Class="CitaPDF.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="Configuración" SizeToContent="Height" Width="620" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <TextBlock Text="Filas visibles en el grid principal:" VerticalAlignment="Center"/>
            <TextBox x:Name="TxtFilasVisibles" Width="60" Margin="8,0,0,0" VerticalContentAlignment="Center"/>
        </StackPanel>
        <TextBlock Grid.Row="0" Text="(mínimo 3)" Foreground="Gray" FontStyle="Italic"
                    HorizontalAlignment="Right" VerticalAlignment="Center"/>

        <StackPanel Grid.Row="1" Margin="0,16,0,0">
            <TextBlock Text="Carpeta de datos (config.json / biblioteca.json):" FontWeight="Bold"/>
            <DockPanel Margin="0,4,0,0">
                <Button x:Name="BtnUnificar" DockPanel.Dock="Right" Content="Unificar con otra..." Padding="10,4"
                        Margin="6,0,0,0" Click="BtnUnificar_Click"
                        ToolTip="Suma a esta biblioteca lo que tenga otra copia (de otra PC, pendrive, respaldo...)"/>
                <Button x:Name="BtnGuardarCopia" DockPanel.Dock="Right" Content="Guardar copia..." Padding="10,4"
                        Margin="8,0,0,0" Click="BtnGuardarCopia_Click"
                        ToolTip="Guarda una copia de biblioteca.json en la ubicación que elijas"/>
                <TextBox x:Name="TxtCarpetaDatos" IsReadOnly="True" Background="#FFF0F0F0"
                         VerticalContentAlignment="Center"/>
            </DockPanel>
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,16,0,0">
            <TextBlock Text="Tema:" FontWeight="Bold"/>
            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <RadioButton x:Name="RbTemaClaro" Content="Claro" GroupName="Tema"
                             Checked="Tema_Changed" Margin="0,0,16,0" VerticalAlignment="Center"/>
                <RadioButton x:Name="RbTemaOscuro" Content="Oscuro" GroupName="Tema"
                             Checked="Tema_Changed" Margin="0,0,16,0" VerticalAlignment="Center"/>
                <RadioButton x:Name="RbTemaTextura" Content="Textura" GroupName="Tema"
                             Checked="Tema_Changed" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <TextBox x:Name="TxtRutaTextura" Width="300" IsReadOnly="True"
                         Background="#FFF0F0F0" VerticalContentAlignment="Center"/>
                <Button x:Name="BtnExaminarTextura" Content="Examinar..." Padding="10,4" Margin="8,0,0,0"
                        Click="BtnExaminarTextura_Click"/>
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="3" Margin="0,16,0,0">
            <TextBlock Text="Modelo local:" FontWeight="Bold"/>
            <TextBlock Text="Servidor (llama-server.exe):" Margin="0,4,0,0"/>
            <DockPanel Margin="0,2,0,0">
                <Button DockPanel.Dock="Right" Content="Buscar..." Padding="10,4" Margin="6,0,0,0"
                        Click="BtnBuscarServidor_Click" ToolTip="Buscar llama-server.exe en todas las unidades"/>
                <Button DockPanel.Dock="Right" Content="Examinar..." Padding="10,4" Margin="8,0,0,0"
                        Click="BtnExaminarServidor_Click"/>
                <TextBox x:Name="TxtRutaServidor" IsReadOnly="True" Background="#FFF0F0F0"
                         VerticalContentAlignment="Center"/>
            </DockPanel>
            <TextBlock Text="Modelo (.gguf):" Margin="0,6,0,0"/>
            <DockPanel Margin="0,2,0,0">
                <Button DockPanel.Dock="Right" Content="Buscar..." Padding="10,4" Margin="6,0,0,0"
                        Click="BtnBuscarModelo_Click" ToolTip="Buscar modelos .gguf en todas las unidades"/>
                <Button DockPanel.Dock="Right" Content="Examinar..." Padding="10,4" Margin="8,0,0,0"
                        Click="BtnExaminarModelo_Click"/>
                <TextBox x:Name="TxtRutaModelo" IsReadOnly="True" Background="#FFF0F0F0"
                         VerticalContentAlignment="Center"/>
            </DockPanel>
            <TextBlock x:Name="TxtAvisoRutas" Margin="0,4,0,0" Foreground="Gray" FontStyle="Italic"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <StackPanel Grid.Row="4" Margin="0,16,0,0">
            <TextBlock Text="Aplicación:" FontWeight="Bold"/>
            <DockPanel Margin="0,4,0,0">
                <Button x:Name="BtnActualizar" DockPanel.Dock="Right" Content="Buscar actualización" Padding="10,4"
                        Margin="8,0,0,0" Click="BtnActualizar_Click"
                        ToolTip="Consulta la última versión publicada en GitHub e instala el nuevo CitaPDF.exe (no toca la carpeta datos)"/>
                <TextBlock x:Name="TxtVersion" VerticalAlignment="Center"/>
            </DockPanel>
            <TextBlock x:Name="TxtEstadoActualizacion" Margin="0,4,0,0" Foreground="Gray" FontStyle="Italic"
                       TextWrapping="Wrap" Visibility="Collapsed"/>
        </StackPanel>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="BtnGuardar" Content="Guardar" Padding="10,6" Click="BtnGuardar_Click" IsDefault="True"/>
            <Button x:Name="BtnCancelar" Content="Cancelar" Padding="10,6" Margin="8,0,0,0" Click="BtnCancelar_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
