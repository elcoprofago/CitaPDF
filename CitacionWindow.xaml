<Window x:Class="CitaPDF.CitacionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="Cita APA" Height="480" Width="620" WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="TxtAviso" Grid.Row="0" Margin="0,0,0,10" TextWrapping="Wrap"
                   Foreground="DarkOrange" FontWeight="Bold" Visibility="Collapsed"
                   Text="No se pudo extraer la cita automáticamente. Completá los datos a mano."/>

        <TextBlock Grid.Row="1" Text="Título" FontWeight="Bold" Margin="0,4,0,2"/>
        <TextBox x:Name="TxtTitulo" Grid.Row="1" Margin="0,20,0,0" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"/>

        <TextBlock Grid.Row="2" Text="Autores (uno por línea, ya en formato APA)" FontWeight="Bold" Margin="0,10,0,2"/>
        <TextBox x:Name="TxtAutores" Grid.Row="2" Margin="0,26,0,0" Height="60" IsReadOnly="True"
                 AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>

        <Grid Grid.Row="3" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Año" FontWeight="Bold" Margin="0,0,0,2"/>
                <TextBox x:Name="TxtAnio" IsReadOnly="True"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                <TextBlock Text="Editorial / fuente" FontWeight="Bold" Margin="0,0,0,2"/>
                <TextBox x:Name="TxtEditorial" IsReadOnly="True"/>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="4" Margin="0,10,0,0">
            <TextBlock Text="URL de origen" FontWeight="Bold" Margin="0,0,0,2"/>
            <TextBox x:Name="TxtUrl" IsReadOnly="True"/>
        </StackPanel>

        <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,10,0,0">
            <Button x:Name="BtnCorregir" Content="Corregir" Padding="8,4" Click="BtnCorregir_Click"/>
            <Button x:Name="BtnReconstruir" Content="Reconstruir cita" Padding="8,4" Margin="8,0,0,0"
                    IsEnabled="False" Click="BtnReconstruir_Click"/>
        </StackPanel>

        <GroupBox Grid.Row="6" Header="Cita APA (7ª ed.)" Margin="0,10,0,0">
            <TextBlock x:Name="TxtCita" TextWrapping="Wrap" Margin="6" FontSize="14"/>
        </GroupBox>

        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="BtnCopiarCita" Content="Copiar cita" Padding="10,6" Click="BtnCopiarCita_Click"/>
            <Button x:Name="BtnCopiarEnlace" Content="Copiar enlace" Padding="10,6" Margin="8,0,0,0" Click="BtnCopiarEnlace_Click"/>
            <Button x:Name="BtnAbrir" Content="Abrir" Padding="10,6" Margin="8,0,0,0" Click="BtnAbrir_Click"/>
            <Button x:Name="BtnCerrar" Content="Cerrar" Padding="10,6" Margin="8,0,0,0" Click="BtnCerrar_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
