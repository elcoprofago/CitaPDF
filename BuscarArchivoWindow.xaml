<Window x:Class="CitaPDF.BuscarArchivoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Buscar" Height="420" Width="680" WindowStartupLocation="CenterOwner">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="TxtEstado" Grid.Row="0" TextTrimming="CharacterEllipsis" Foreground="Gray"/>

        <ListBox x:Name="LstResultados" Grid.Row="1" Margin="0,8,0,0"
                 MouseDoubleClick="LstResultados_MouseDoubleClick"
                 SelectionChanged="LstResultados_SelectionChanged"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="BtnElegir" Content="Elegir" Padding="10,6" IsEnabled="False"
                    Click="BtnElegir_Click" IsDefault="True"/>
            <Button x:Name="BtnCancelar" Content="Cancelar" Padding="10,6" Margin="8,0,0,0"
                    Click="BtnCancelar_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
